
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krevo",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-archive-db",
      "database_id": "a6340a95-4043-4d53-aa4c-0b472d536763",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
