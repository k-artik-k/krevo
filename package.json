{
  "name": "project-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
  "dev": "vite",
  "predev": "node scripts/check-env.mjs",
  "build": "tsc -b && vite build",
  "preview": "npm run check-env && vite build && vite preview",
  "typecheck": "tsc -b",
  "deploy": "npm run build && wrangler deploy",
  "db:migrate:local": "wrangler d1 migrations apply DB --local",
  "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
  "hash-password": "node scripts/hash-password.mjs",
  "check-env": "node scripts/check-env.mjs"
},
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
